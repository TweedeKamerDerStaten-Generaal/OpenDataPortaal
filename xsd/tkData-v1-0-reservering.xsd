<?xml version="1.0" encoding="utf-8"?>
<xs:schema
  elementFormDefault="qualified"
  attributeFormDefault="unqualified"
  targetNamespace="http://www.tweedekamer.nl/xsd/tkData/v1-0"
  xmlns="http://www.tweedekamer.nl/xsd/tkData/v1-0"
  xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:include schemaLocation="tkData-v1-0-base.xsd"/>

  <xs:element name="reservering" type="reserveringType"/>

  <xs:complexType name="reserveringType" final="#all">
    <xs:complexContent>
      <xs:extension base="entiteitType">
        <xs:sequence minOccurs="0">
          <!-- Attributen -->
          <xs:element name="nummer" minOccurs="1" maxOccurs="1" nillable="true" type="tokenType"/>
          <xs:element name="statusCode" minOccurs="1" maxOccurs="1" nillable="true" type="tokenType"/>
          <xs:element name="statusNaam" minOccurs="1" maxOccurs="1" nillable="true" type="tokenType"/>
          <xs:element name="activiteitNummer" minOccurs="1" maxOccurs="1" nillable="true" type="tokenType"/>
          <!-- Relaties -->
          <xs:element name="zaal" minOccurs="1" maxOccurs="1" type="referentieLiteral"/>
          <xs:element name="activiteit" minOccurs="1" maxOccurs="1" type="referentieLiteral"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>